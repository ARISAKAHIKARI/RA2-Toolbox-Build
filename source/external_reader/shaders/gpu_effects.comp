   vec2 scale=vec2(f(i,23),f(i,24));float distance=length((vec2(at)-vec2(f(i,21),f(i,22)))/scale);int sine=int(sin((distance+float(int(u(i,25))))*(u(i,26)==3u?.1:.125))*12.+.49);int mag=min(u(i,26)==3u?9:12,abs(sine)),multiple=mag<=1?0:mag<=6?1:mag<=9?2:3;
   const ivec2 directions[8]=ivec2[8](ivec2(0,-1),ivec2(1,-1),ivec2(1,0),ivec2(1,1),ivec2(0,1),ivec2(-1,1),ivec2(-1,0),ivec2(-1,-1));vec2 delta=vec2(directions[u(i,27)])*float(multiple)*scale;ivec2 q=clamp(ivec2(at)+ivec2(roundAway(delta.x),roundAway(delta.y)),ivec2(0),ivec2(p.width-1u,p.height-1u));
   uint source=pixel[p.snapshotOffset+uint(q.y)*p.width+uint(q.x)],o=0xff000000u;for(uint sh=0;sh<24;sh+=8){uint value=min(255u,(((source>>sh)&255u)*uint(110+mag*8))/128u);o|=((value*visible+((dst>>sh)&255u)*(127u-visible))/127u)<<sh;}dst=o;
  }else if(kind==4u){int hits=boltHits(i,ivec2(at));for(int k=0;k<hits;++k)bolt=over(rgb,bolt);}
 }
 if(bolt!=0u){uint masked=0;for(uint sh=0;sh<32;sh+=8)masked|=((((bolt>>sh)&255u)*visible+63u)/127u)<<sh;dst=over(masked,dst);}pixel[address]=dst;
}
