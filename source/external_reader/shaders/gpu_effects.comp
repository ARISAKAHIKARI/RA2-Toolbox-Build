int roundAway(float v){return int(sign(v)*floor(abs(v)+0.5));}
int lineHits(uint i,ivec2 at){
 vec2 a=vec2(f(i,8),f(i,9)),b=vec2(f(i,10),f(i,11)),delta=b-a;int count=int(u(i,12));if(count==0)return at==ivec2(roundAway(a.x),roundAway(a.y))?1:0;
