  else if(kind==1u){vec2 d=(vec2(at)-vec2(f(i,8),f(i,9)))/vec2(f(i,10),f(i,11));float strength=max(0.,1.-length(d))*.3;uint c=0;for(uint sh=0;sh<24;sh+=8)c|=uint(float((rgb>>sh)&255u)*strength)<<sh;dst=lit(dst,c,visible,true);}
  else if(kind==2u){ivec2 q=clamp(ivec2((vec2(at)-vec2(f(i,8),f(i,9)))/vec2(f(i,10),f(i,11))),ivec2(0),ivec2(u(i,14)-1u,u(i,15)-1u));uint index=byteAt(u(i,3),uint(q.y)*u(i,14)+uint(q.x));if(index!=0){uint o=0xff000000u;for(uint sh=0;sh<24;sh+=8){uint old=(dst>>sh)&255u,value=min(255u,old*index/128u);o|=((value*visible+old*(127u-visible))/127u)<<sh;}dst=o;}}
