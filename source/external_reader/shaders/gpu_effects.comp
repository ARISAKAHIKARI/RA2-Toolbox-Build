 for(int n=first;n<=last;++n){vec2 q=a+delta*float(n)/float(count);if(at==ivec2(roundAway(q.x),roundAway(q.y)))++hits;}return hits;
}
int boltHits(uint i,ivec2 at){
 ivec2 a=ivec2(u(i,8),u(i,9)),b=ivec2(u(i,10),u(i,11)),d=abs(b-a),step=ivec2(a.x<b.x?1:-1,a.y<b.y?1:-1);int r=int(u(i,13));bool majorX=d.x>=d.y;int major=majorX?d.x:d.y,minor=majorX?d.y:d.x;
 if(major==0)return all(lessThanEqual(abs(at-a),ivec2(r)))?1:0;
 int center=(majorX?at.x-a.x:at.y-a.y)*(majorX?step.x:step.y),hits=0;
 for(int n=max(0,center-r);n<=min(major,center+r);++n){int m=(n*minor*2+major)/(major*2);ivec2 q=a+(majorX?ivec2(n,m):ivec2(m,n))*step;if(all(lessThanEqual(abs(at-q),ivec2(r))))++hits;}return hits;
}
bool insideWave(uint i,ivec2 at){
 float crosses[6];uint count=0,vertices=u(i,20);for(uint n=0;n<vertices;++n){uint next=(n+1u)%vertices;vec2 a=vec2(f(i,8+2*n),f(i,9+2*n)),b=vec2(f(i,8+2*next),f(i,9+2*next));float y=float(at.y)+.5;if((a.y>y)!=(b.y>y))crosses[count++]=a.x+(y-a.y)*(b.x-a.x)/(b.y-a.y);}
 for(uint n=1;n<count;++n)for(uint k=n;k>0&&crosses[k]<crosses[k-1];--k){float t=crosses[k];crosses[k]=crosses[k-1];crosses[k-1]=t;}
 for(uint n=0;n+1<count;n+=2)if(at.x>=int(ceil(crosses[n]))&&at.x<=int(floor(crosses[n+1])))return true;return false;
}
void main(){
 uvec2 at=gl_GlobalInvocationID.xy+uvec2(p.left,p.top);if(at.x>=p.right||at.y>=p.bottom||at.x>=p.width||at.y>=p.height)return;
 uint address=at.y*p.width+at.x,visible=p.fogOffset==0xffffffffu?127u:byteAt(p.fogOffset,address);if(visible==0)return;
 uint bin=(at.y/32u)*p.columns+at.x/32u,start=command[p.binsOffset+2u*bin],count=command[p.binsOffset+2u*bin+1u],dst=pixel[address],bolt=0;
 for(uint n=0;n<count;++n){uint i=command[p.refsOffset+start+n];if(at.x<u(i,4)||at.y<u(i,5)||at.x>=u(i,6)||at.y>=u(i,7))continue;uint kind=u(i,0),rgb=u(i,1);
