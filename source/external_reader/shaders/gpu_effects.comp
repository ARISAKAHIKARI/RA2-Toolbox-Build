} p;
uint u(uint i,uint n){return command[p.drawsOffset+i*32u+n];}
float f(uint i,uint n){return uintBitsToFloat(u(i,n));}
uint byteAt(uint offset,uint at){return (material[offset+at/4u]>>((at%4u)*8u))&255u;}
uint over(uint s,uint d){uint inv=255u-(s>>24),o=0;for(uint sh=0;sh<32;sh+=8)o|=min(255u,((s>>sh)&255u)+(((d>>sh)&255u)*inv+127u)/255u)<<sh;return o;}
