layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=1) readonly buffer Materials {uint material[];};
layout(std430,binding=2) readonly buffer Commands {uint command[];};
layout(std430,binding=3) buffer Output {uint pixel[];};
layout(push_constant) uniform Params {
 uint width,height,drawsOffset,binsOffset,refsOffset,columns,fogOffset,snapshotOffset;
