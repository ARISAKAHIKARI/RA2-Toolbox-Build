#include "release_version.h"
1 VERSIONINFO
 FILEVERSION RA2_RELEASE_VERSION_PARTS
 PRODUCTVERSION RA2_RELEASE_VERSION_PARTS
 FILEFLAGSMASK 0x3f
 FILEFLAGS 0
 FILEOS 0x40004
 FILETYPE 2
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "RA2 Toolbox Bridge\0"
   VALUE "FileVersion", RA2_RELEASE_VERSION "\0"
   VALUE "ProductName", "RA2 Toolbox\0"
   VALUE "ProductVersion", RA2_RELEASE_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
