  "production_changes": [
    {
      "id": "snapshot-storage-reuse",
      "files": [
        "source/shared/source/world_frame_pool.h",
        "source/shared/source/world_frame_transport.h"
      ],
      "behavior": "Snapshot and PageBuffer storage returns to a bounded three-idle-slot pool only after the last strong publication token is released. Every publication receives a new shared_ptr control block; weak identity cannot revive. Saturation allocates a normal fallback; a full idle pool deletes the returned object. No new lock, wait, skipped acquisition, lowered cadence or wire layout change.",
      "lifecycle": "Release CAS/acquire exchange transfers exclusive raw storage. The deleter moves its pool reference to a local before returning storage, so expired weak controls cannot retain the pool. clearCopy clears idle storage and detaches the old pool; late tokens retain and return only to that old pool.",
      "design_rejected": "Direct shared_ptr FramePool reuse would keep weak tokens alive and could make converterMetadata/radar terrain weak identity reuse stale content. That draft was replaced before final verification.",
      "scope": "Original Client mutex boundaries and import/seqlock acceptance remain. Each cold allocation and every required payload copy remain permitted.",
      "memory_tradeoff": "At most three idle Snapshot/page buffers are retained per live pool in addition to currently held publications; storage grows on demand and is cleared when the transport copy retires. At maximum page capacity each page buffer is 84,017,152 bytes; the three-idle-page-buffer bound is 252,051,456 bytes, not a preallocation. Normal steady two-buffer reuse uses fewer idle slots."
    },
    {
      "id": "exact-tech-single-array-pass",
      "files": [
        "source/assist/source/tech_ui_breakpoint_bridge.h"
      ],
      "behavior": "One traversal per native type array at the existing cold refresh boundary; decode each visited member once for all applicable rules. Preserve each rule first matching index; stop an array once every corresponding rule is captured. No heap allocation or persistent authorization result cache was added.",
      "preserved": [
        "500 ms clock and wrap behavior",
        "immediate rebuild after missing/unready policy index",
        "world/signature/admission gates",
        "hot callback live identity/level/array checks",
        "Rules/Exact in-production handoff",
        "index publication after full capture",
        "first-match order and UID-zero rejection"
      ]
    }
  ],
